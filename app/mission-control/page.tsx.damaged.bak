import { buildMissionControlOS } from "@/src/lib/mission-control";

const missionControl = buildMissionControlOS();

type MissionControlMetric =
  | (typeof missionControl.executiveDashboard.organizationalHealth)[number]
  | (typeof missionControl.executiveDashboard.participantMetrics)[number]
  | (typeof missionControl.executiveDashboard.transformationMetrics)[number];

interface MetricCardProps {
  metric: MissionControlMetric;
}

function getMetricStatusClassName(
  status: MissionControlMetric["status"],
): string {
  if (status === "on-track") {
    return "bg-green-500/20 text-green-300";
  }

  if (status === "at-risk") {
    return "bg-yellow-500/20 text-yellow-300";
  }

  return "bg-red-500/20 text-red-300";
}

function MetricCard({ metric }: MetricCardProps) {
  const statusClassName = getMetricStatusClassName(metric.status);

  return (
    <div className="rounded-[22px] border border-white/10 bg-white/[0.03] p-5">
      <div className="flex items-start justify-between gap-3">
        <div>
          <p className="text-[10px] uppercase tracking-[0.2em] text-[#D4AF37]">
            {metric.title}
          </p>

          <div className="mt-3 flex items-baseline gap-2">
            <span className="text-3xl font-light text-white">
              {metric.value}
            </span>

            {metric.unit && (
              <span className="text-sm text-white/60">{metric.unit}</span>
            )}
          </div>
        </div>

        <span
          className={`rounded-full px-3 py-1 text-[10px] uppercase tracking-[0.18em] ${statusClassName}`}
        >
          {metric.status}
        </span>
      </div>

      <div className="mt-4 border-t border-white/10 pt-4">
        <p className="text-sm text-white/60">{metric.description}</p>
      </div>
    </div>
  );
} 