PS C:\Users\James\Development\platform> Add-Section $AssetFile "Discovered Visual Assets" @(
    "| Public path | Size KB | Classification | Source references found |",
    "|---|---:|---|---:|",
    $(
        $AssetRows | ForEach-Object {
            "| ``$($_.Asset)`` | $($_.SizeKB) | $($_.Type) | $($_.References) |"
        }
    )
)
>> CommandInvocation(Out-Null): "Out-Null"
PS C:\Users\James\Development\platform> $DuplicateAssets = @(
    $Assets |
        Get-FileHash -Algorithm SHA256 |
        Group-Object Hash |
        Where-Object Count -gt 1
)
PS C:\Users\James\Development\platform> $DuplicateLines = @()
PS C:\Users\James\Development\platform> foreach ($Group in $DuplicateAssets) {
    $DuplicateLines += "`n### Duplicate hash ``$($Group.Name)``"
    $DuplicateLines += $Group.Group |
        ForEach-Object { "- ``$($_.Path.Substring($Root.Length + 1))``" }
}
PS C:\Users\James\Development\platform> Add-Section $AssetFile "Byte-Identical Duplicate Assets" $DuplicateLines
