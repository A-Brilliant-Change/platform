PS C:\Users\James\Development\platform> if (Test-Path $AppRoot) {
    $PageFiles = @(
        Get-ChildItem -Path $AppRoot -Recurse -File -Filter "page.*" -ErrorAction SilentlyContinue |
            Where-Object { $_.Extension -in @(".ts", ".tsx", ".js", ".jsx") }
    )

    foreach ($Page in $PageFiles) {
        $RelativeDirectory = $Page.DirectoryName.Substring($AppRoot.Length).TrimStart("\")
