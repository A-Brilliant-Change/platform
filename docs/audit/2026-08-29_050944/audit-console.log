PS C:\Users\James\Development\platform> Write-Heading -Path $SecurityFile -Title "Security Audit"
PS C:\Users\James\Development\platform> $SensitiveFilePatterns = @(
    ".env",
    ".env.local",
    ".env.production",
    "id_rsa",
    "id_ed25519",
    "*.pem",
    "*.pfx",
    "*.p12",
    "credentials.json",
    "service-account.json"
)
PS C:\Users\James\Development\platform> $SensitiveFiles = @()
PS C:\Users\James\Development\platform> foreach ($Pattern in $SensitiveFilePatterns) {
    $SensitiveFiles += Get-ChildItem -Path $Root -Recurse -File -Force -Filter $Pattern -ErrorAction SilentlyContinue |
        Where-Object { $_.FullName -notmatch "\\(node_modules|\.next|\.git)\\" }
}
PS C:\Users\James\Development\platform> $SensitiveLines = if ($SensitiveFiles.Count -gt 0) {
    $SensitiveFiles |
        Sort-Object FullName -Unique |
        ForEach-Object {
            "- ⚠️ Review file protection and Git tracking: ``$($_.FullName.Substring($Root.Length + 1))``"
        }
}
