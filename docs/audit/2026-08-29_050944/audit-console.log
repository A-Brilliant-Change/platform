PS C:\Users\James\Development\platform> function Format-Check {
    param($Result, [string]$UnavailableMessage)

    if ($null -eq $Result) {
        return "⚠️ $UnavailableMessage"
    }

    if ($Result.Passed) {
        return "✅ Passed"
    }

    return "❌ Failed"
}
