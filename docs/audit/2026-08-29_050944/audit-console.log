PS C:\Users\James\Development\platform> function Write-Heading {
    param([string]$Path, [string]$Title)
    @"
# $Title

**Repository:** ``$Root``  
**Audit generated:** $(Get-Date -Format "yyyy-MM-dd HH:mm:ss zzz")  
**Audit type:** Evidence-based repository inspection

"@ | Set-Content -Path $Path -Encoding utf8
}
PS C:\Users\James\Development\platform> function Add-Section {
    param(
        [string]$Path,
        [string]$Heading,
        [string[]]$Lines
    )

    Add-Content -Path $Path -Value "`n## $Heading`n" -Encoding utf8

    if ($Lines -and $Lines.Count -gt 0) {
        $Lines | Add-Content -Path $Path -Encoding utf8
    }
    else {
        Add-Content -Path $Path -Value "_No evidence found._" -Encoding utf8
    }
}
PS C:\Users\James\Development\platform> function Invoke-AuditCommand {
    param(
        [string]$Name,
        [scriptblock]$Command
    )

    $LogPath = Join-Path $AuditRoot "$Name.log"
    $Started = Get-Date

    try {
        & $Command 2>&1 | Tee-Object -FilePath $LogPath
        $Exit = $LASTEXITCODE
        if ($null -eq $Exit) { $Exit = 0 }
    }
    catch {
        $_ | Out-File -FilePath $LogPath -Append -Encoding utf8
        $Exit = 1
    }

    $Ended = Get-Date
    $Duration = :Round(($Ended - $Started).TotalSeconds, 2)

    [pscustomobject]@{
        Name = $Name
        ExitCode = $Exit
        Passed = ($Exit -eq 0)
        DurationSeconds = $Duration
        Log = $LogPath
    }
}
PS C:\Users\James\Development\platform> function Get-NpmScripts {
    $PackagePath = Join-Path $Root "package.json"

    if (-not (Test-Path $PackagePath)) {
        return @()
    }

    try {
        $Package = Get-Content $PackagePath -Raw | ConvertFrom-Json
        return @($Package.scripts.PSObject.Properties.Name)
    }
    catch {
        return @()
    }
}
