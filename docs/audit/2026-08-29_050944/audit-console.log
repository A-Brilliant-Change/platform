PS C:\Users\James\Development\platform> # ------------------------------------------------------------
PS C:\Users\James\Development\platform> Write-Heading -Path $ManifestFile -Title "Manifest Audit"
PS C:\Users\James\Development\platform> $ManifestFiles = @(
    $AllFiles | Where-Object {
        $_.Name -match "(?i)manifest" -and $_.Extension -in @(".json", ".ts", ".md")
    }
)
PS C:\Users\James\Development\platform> $ManifestRows = @()
PS C:\Users\James\Development\platform> foreach ($Manifest in ($ManifestFiles | Sort-Object FullName)) {
    $JsonStatus = "Not JSON"

    if ($Manifest.Extension -eq ".json") {
        try {
            Get-Content $Manifest.FullName -Raw | ConvertFrom-Json | Out-Null
            $JsonStatus = "✅ Valid JSON"
        }
        catch {
            $JsonStatus = "❌ Invalid JSON"
        }
    }

    $ManifestRows += [pscustomobject]@{
        File = $Manifest.FullName.Substring($Root.Length + 1)
        Size = $Manifest.Length
        Validation = $JsonStatus
    }
}
PS C:\Users\James\Development\platform> Add-Section $ManifestFile "Discovered Manifests" @(
    "| Manifest | Bytes | Basic validation |",
    "|---|---:|---|",
    $(
        $ManifestRows | ForEach-Object {
            "| ``$($_.File)`` | $($_.Size) | $($_.Validation) |"
        }
    )
)
PS C:\Users\James\Development\platform> $ExpectedManifests = @(
    "domains.manifest.json",
    "programs.manifest.json",
    "doctrine.manifest.json",
    "assets.manifest.json",
    "agents.manifest.json",
    "journeys.manifest.json",
    "participants.manifest.json"
)
PS C:\Users\James\Development\platform> $ExpectedManifestLines = foreach ($Name in $ExpectedManifests) {
    $Found = @($ManifestFiles | Where-Object Name -eq $Name)
    if ($Found.Count -gt 0) {
        "- ✅ ``$Name`` found at ``$($Found[0].FullName.Substring($Root.Length + 1))``"
    }
    else {
        "- ❌ ``$Name`` not found"
    }
}
PS C:\Users\James\Development\platform> Add-Section $ManifestFile "Expected Governance Manifests" $ExpectedManifestLines
PS C:\Users\James\Development\platform> # ------------------------------------------------------------
PS C:\Users\James\Development\platform> # Placeholder, stub, TODO and hardcoded-demo audit
PS C:\Users\James\Development\platform> # ------------------------------------------------------------
PS C:\Users\James\Development\platform> Write-Heading -Path $PlaceholderFile -Title "Placeholder and Stub Audit"
PS C:\Users\James\Development\platform> $PlaceholderPatterns = @(
    "TODO",
    "FIXME",
    "HACK",
    "placeholder",
    "not implemented",
    "coming soon",
    "mock data",
    "sample data",
    "demo data",
    "lorem ipsum"
)
PS C:\Users\James\Development\platform> $PlaceholderMatches = @()
PS C:\Users\James\Development\platform> foreach ($Pattern in $PlaceholderPatterns) {
    $Matches = @(
        $SourceFiles |
            Select-String -Pattern $Pattern -SimpleMatch -CaseSensitive:$false -ErrorAction SilentlyContinue
    )

    foreach ($Match in $Matches) {
        $PlaceholderMatches += [pscustomobject]@{
            Pattern = $Pattern
            File = $Match.Path.Substring($Root.Length + 1)
            Line = $Match.LineNumber
            Preview = ($Match.Line.Trim() -replace "\|", "\/")
        }
    }
}
PS C:\Users\James\Development\platform> Add-Section $PlaceholderFile "Detected Markers" @(
    "| Marker | File | Line | Preview |",
    "|---|---|---:|---|",
    $(
        $PlaceholderMatches |
            Sort-Object File, Line |
            ForEach-Object {
                $Preview = $_.Preview
                if ($Preview.Length -gt 140) {
                    $Preview = $Preview.Substring(0, 140) + "..."
                }
                "| ``$($_.Pattern)`` | ``$($_.File)`` | $($_.Line) | $Preview |"
            }
    )
)
