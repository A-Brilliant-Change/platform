            Classification = $Classification
        }
    }

    Add-Section $RouteFile "Discovered Routes" @(
        "| Route | Page file | Preliminary classification |",
        "|---|---|---|",
        $(
            $RoutePages |
                Sort-Object Route |
                ForEach-Object {
                    "| ``$($_.Route)`` | ``$($_.File)`` | $($_.Classification) |"
